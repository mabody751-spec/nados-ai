# Server-only secrets. Never prefix these variables with VITE_.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HUGGINGFACE_TOKEN=
# Supabase persistence for conversations (activates when both are set).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Kaggle cloud training (free-first: P100/T4 GPU) — from kaggle.com → Settings → API.
KAGGLE_USERNAME=
KAGGLE_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Limit Nados v1.0 to the providers you have configured.
NADOS_ENABLED_PROVIDERS=true-sota,true-sota-2,odyssey,nvidia
NADOS_PROVIDER_ORDER=true-sota,true-sota-2,odyssey,nvidia
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-pro-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts,gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b,openai/gpt-oss-120b,allam-2-7b
GROQ_SEARCH_MODEL=groq/compound-mini
GROQ_SEARCH_MODELS=groq/compound-mini,groq/compound
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_MODELS=whisper-large-v3-turbo,whisper-large-v3
OPENROUTER_MODEL=openrouter/free
# Set this only to an OpenRouter model that accepts image input.
OPENROUTER_VISION_MODEL=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Reply length adapts automatically: model context window minus live conversation tokens, measured in tokens.
# Optional manual caps: GROQ_MAX_TOKENS, GROQ_SEARCH_MAX_TOKENS, GEMINI_MAX_TOKENS,
# NVIDIA_MAX_TOKENS, CUSTOM_PROVIDER_MAX_TOKENS, or NADOS_MAX_OUTPUT_TOKENS for all providers.
# Internal OpenAI routing for the single public model: Nados v1.0.
NADOS_V1_FAST_MODEL=gpt-5-mini
NADOS_V1_REASONING_MODEL=gpt-5
NADOS_V1_VISION_MODEL=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
PORT=8787

# Work mode — real execution sandbox. Each project gets its own isolated
# workspace folder; the local engine executes real filesystem + process calls.
# Execution and preview routes are restricted to local requests (the app has no
# auth layer yet). In a Cloudflare Containers deployment, point these at the
# mounted sandbox and swap the local provider for Cloudflare Sandbox.
# Leave NADOS_WORKSPACES_ROOT empty to use <cwd>/workspaces.
NADOS_WORKSPACES_ROOT=
NADOS_WORK_MAX_STEPS=50
NADOS_WORK_MAX_RETRIES=3
NADOS_WORK_COMMAND_TIME_MS=120000
NADOS_WORK_INSTALL_TIME_MS=300000
NADOS_WORK_SERVER_BOOT_MS=45000
NADOS_WORK_MAX_FILE_BYTES=2000000
NADOS_WORK_MAX_FILES=3000
NADOS_WORK_MAX_PROJECT_BYTES=200000000
NADOS_WORK_CHANGE_SNAPSHOT_BYTES=200000
NADOS_WORK_CHANGE_TOTAL_BYTES=8000000
NADOS_WORK_RATE_LIMIT=300

# Work mode model routing. GLM 5.3 Flash on NVIDIA is the primary Work model;
# GPT-OSS 20B (served by Groq) is the chat default and the Work fallback.
NADOS_WORK_PROVIDER=nvidia
NADOS_WORK_MODEL=z-ai/glm-5.3-flash
NADOS_WORK_FALLBACK_MODEL=openai/gpt-oss-20b
NADOS_CHAT_MODEL=openai/gpt-oss-20b
# Consecutive identical read-only tool calls before a Work task parks as stalled,
# and the read-only streak (with no writes) that also parks it.
NADOS_WORK_MAX_REPEATS=4
NADOS_WORK_MAX_READONLY_STREAK=12

# NVIDIA NIM catalog: all NVIDIA models are discovered from the provider and
# probed with a real completion; only models that answer are offered.
NADOS_NVIDIA_CATALOG_TTL_MS=86400000
NADOS_TRAINING_MAX_TEACHERS=6
NADOS_TRAINING_TEACHER_TIMEOUT_MS=120000
# Refresh + probe every NVIDIA model: npm run nvidia:refresh

# Shared token required from the public Cloudflare Worker proxy when the API is
# exposed through a tunnel. Local requests never need it.
NADOS_PROXY_TOKEN=

# Per-IP limit for chat/audio inference requests per minute (Phase 6).
NADOS_CHAT_RATE_LIMIT=60

# Extended memory tuning (Phase 5). Depth is chosen per request (full|balanced|off).
NADOS_MEMORY_KEEP_RECENT=12
NADOS_MEMORY_MAX_RELEVANT=6
# Trained-model routing (CPU host)
NADOS_LOCAL_TIMEOUT_MS=20000
NADOS_LOCAL_MAX_TOKENS=512
