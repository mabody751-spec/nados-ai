# Server-only secrets. Never prefix these variables with VITE_.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HUGGINGFACE_TOKEN=
# Supabase persistence for conversations (activates when both are set).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Kaggle cloud training (free-first: P100/T4 GPU) — from kaggle.com → Settings → API.
KAGGLE_USERNAME=
KAGGLE_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Limit Nados v1.0 to the providers you have configured.
NADOS_ENABLED_PROVIDERS=true-sota,true-sota-2,odyssey,nvidia
NADOS_PROVIDER_ORDER=true-sota,true-sota-2,odyssey,nvidia
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-pro-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts,gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-2.5-flash-image,gemini-3-pro-image
GEMINI_IMAGE_ENABLED=false
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b,openai/gpt-oss-120b,allam-2-7b
GROQ_SEARCH_MODEL=groq/compound-mini
GROQ_SEARCH_MODELS=groq/compound-mini,groq/compound
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_MODELS=whisper-large-v3-turbo,whisper-large-v3
OPENROUTER_MODEL=openrouter/free
# Set this only to an OpenRouter model that accepts image input.
OPENROUTER_VISION_MODEL=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Reply length adapts automatically: model context window minus live conversation tokens, measured in tokens.
# Optional manual caps: GROQ_MAX_TOKENS, GROQ_SEARCH_MAX_TOKENS, GEMINI_MAX_TOKENS,
# NVIDIA_MAX_TOKENS, CUSTOM_PROVIDER_MAX_TOKENS, or NADOS_MAX_OUTPUT_TOKENS for all providers.
# Internal OpenAI routing for the single public model: Nados v1.0.
NADOS_V1_FAST_MODEL=gpt-5-mini
NADOS_V1_REASONING_MODEL=gpt-5
NADOS_V1_VISION_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
PORT=8787
