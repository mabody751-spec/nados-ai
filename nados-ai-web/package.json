{
  "name": "nados-ai-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.mjs",
    "keepalive": "node server/supervisor.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test server/*.test.mjs server/training/*.test.mjs",
    "test:e2e": "playwright test",
    "preview": "npm run build && wrangler dev",
    "start": "node server/index.mjs",
    "nvidia:catalog": "node scripts/nvidia-probe.mjs --catalog",
    "nvidia:probe": "node scripts/nvidia-probe.mjs",
    "nvidia:refresh": "node scripts/nvidia-probe.mjs --refresh",
    "deploy": "npm run build && wrangler deploy",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && cap sync android && cap build android --androidreleasetype APK",
    "android:aab": "npm run build && cap sync android && cap build android --androidreleasetype AAB",
    "android:assets": "capacitor-assets generate --android",
    "smoke": "node scripts/smoke.mjs",
    "eval": "node scripts/eval.mjs",
    "tunnel:watch": "node scripts/tunnel-watch.mjs",
    "docker:build": "npm run build && docker build -t nados-api ."
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capawesome/capacitor-file-picker": "^7.2.0",
    "@huggingface/inference": "^4.13.28",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@vitejs/plugin-react": "latest",
    "dotenv": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "wrangler": "^4.135.0"
  }
}
